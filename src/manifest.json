{
  "manifest_version": 3,
  "name": "brouter-imperial",
  "version": "1.1.0",
  "icons": {
    "128": "icon.png"
  },
  "description": "Displays BRouter route distances in miles and ascent values in feet.",
  "content_scripts": [
    {
      "matches": [
        "*://brouter.de/*",
        "*://*.brouter.de/*"
      ],
      "js": [
        "imperial-markers.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://brouter.de/*",
        "*://*.brouter.de/*"
      ],
      "js": [
        "converter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
